#!/usr/bin/env bash
# ModSync launch hook for Steam app @@APPID@@ (@@GAME_NAME@@).
# Generated by ModSync @@MODSYNC_VERSION@@ — do not edit; `modsync launch disable`
# removes this directory and gives Steam back its previous choice.
#
# Steam runs this in place of Proton when you press Play. It opens ModSync
# first. Play there starts Mod Organizer 2 as this very launch: ModSync hands
# back a Proton and MO2's command line, which run here in place of the game's
# own program, so Steam tracks the game and syncs its cloud saves as usual.
# Without that (no MO2 set up), the launch goes on to the tool Steam used
# before, inside the Steam Linux Runtime container that tool asks for:
#     @@UNDERLYING_DISPLAY@@   (@@UNDERLYING_PATH@@)
# No "require_tool_appid" in toolmanifest.vdf means Steam runs this script on
# the host, where a window can be shown; Steam Tinker Launch works the same way.
set -u

appid="@@APPID@@"
underlying="@@UNDERLYING_PATH@@"
underlying_name="@@UNDERLYING_NAME@@"
modsync=(@@MODSYNC_COMMAND@@)
libraries=(@@LIBRARY_PATHS@@)

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/modsync"
mkdir -p "$log_dir" 2>/dev/null
log_file="$log_dir/launch-hook.log"
if [[ -f "$log_file" ]] && (( $(wc -c < "$log_file" 2>/dev/null || echo 0) > 200000 )); then
    tail -n 200 "$log_file" > "$log_file.tmp" 2>/dev/null && mv -f "$log_file.tmp" "$log_file"
fi
log() { printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$appid" "$*" >> "$log_file" 2>/dev/null; }

verb="${1-}"

# --- 1. the ModSync hub --------------------------------------------------------
# Only for the actual Play press. Steam uses "run" for setup steps (installscripts,
# first-time setup) and the other verbs are path queries; none of those should
# open a window. Once the hub has run, nothing further down the chain re-opens it.
if [[ "$verb" == "waitforexitandrun" && -z "${MODSYNC_LAUNCH_HUB:-}" ]]; then
    export MODSYNC_LAUNCH_HUB=1
    hub=("${modsync[@]}")
    if [[ -f /.flatpak-info ]] && command -v flatpak-spawn >/dev/null 2>&1; then
        hub=(flatpak-spawn --host "${modsync[@]}")   # Steam itself is a Flatpak
    fi
    log "opening the hub: ${hub[*]} launch hub --appid $appid --through $underlying_name"
    # Steam preloads its overlay and points LD_LIBRARY_PATH at its runtime; both
    # are for the game, not for a Qt app, and make the hub load the wrong Qt.
    saved_preload="${LD_PRELOAD-}"; saved_libpath="${LD_LIBRARY_PATH-}"; saved_audit="${LD_AUDIT-}"
    unset LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
    # Its stdout carries the handoff (see below); everything else it says is logged.
    handoff_file=$(mktemp "$log_dir/handoff.XXXXXX" 2>/dev/null || mktemp 2>/dev/null) || handoff_file=/dev/null
    "${hub[@]}" launch hub --appid "$appid" --through "$underlying_name" </dev/null >"$handoff_file" 2>>"$log_file"
    rc=$?
    handoff=()
    if [[ "$handoff_file" != /dev/null ]]; then
        mapfile -d '' -t handoff < "$handoff_file"
        rm -f "$handoff_file"
    fi
    [[ -n "$saved_preload" ]] && export LD_PRELOAD="$saved_preload"
    [[ -n "$saved_libpath" ]] && export LD_LIBRARY_PATH="$saved_libpath"
    [[ -n "$saved_audit" ]] && export LD_AUDIT="$saved_audit"
    case "$rc" in
        0)  log "continue" ;;
        10) log "cancelled; ending the launch"; exit 0 ;;
        *)  log "hub exited with $rc; launching anyway"; handoff=() ;;
    esac
    # The handoff: a tag, the Proton directory, the folder to start in, then the
    # program and its arguments. They replace the game's program and Steam's
    # arguments for it; the verb, Steam's environment and the prefix stay.
    if (( ${#handoff[@]} >= 4 )) && [[ "${handoff[0]}" == "@@HANDOFF_TAG@@" ]]; then
        if [[ -e "${handoff[1]}/proton" && -d "${handoff[2]}" ]]; then
            underlying="${handoff[1]}"
            underlying_name="${underlying##*/}"
            cd "${handoff[2]}" || exit 1
            log "playing through ModSync: ${handoff[*]:3} (with $underlying_name, in ${handoff[2]})"
            set -- "$verb" "${handoff[@]:3}"
        else
            log "WARNING: ModSync handed back ${handoff[1]} and ${handoff[2]}, which are not there; launching the game"
        fi
    elif (( ${#handoff[@]} )); then
        log "WARNING: ignoring unexpected output from ModSync: ${handoff[*]}"
    fi
fi

# --- 2. hand the same launch on -----------------------------------------------
proton="$underlying/proton"
if [[ ! -e "$proton" ]]; then
    log "ERROR: '$underlying' is gone. Run 'modsync launch disable', or pick a Proton under Properties -> Compatibility."
    exit 1
fi

runtime=""
runtime_appid=$(sed -n 's/.*"require_tool_appid"[[:space:]]*"\([0-9]*\)".*/\1/p' "$underlying/toolmanifest.vdf" 2>/dev/null | head -n 1)
if [[ -n "$runtime_appid" && ( "$verb" == "run" || "$verb" == "waitforexitandrun" ) ]]; then
    IFS=: read -r -a compat_libs <<< "${STEAM_COMPAT_LIBRARY_PATHS:-}"
    for lib in "${compat_libs[@]}" "${STEAM_COMPAT_CLIENT_INSTALL_PATH:-}" "${libraries[@]}"; do
        [[ -n "$lib" ]] || continue
        for steamapps in "$lib/steamapps" "$lib"; do
            acf="$steamapps/appmanifest_$runtime_appid.acf"
            [[ -f "$acf" ]] || continue
            installdir=$(sed -n 's/^[[:space:]]*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$acf" | head -n 1)
            if [[ -n "$installdir" && -x "$steamapps/common/$installdir/_v2-entry-point" ]]; then
                runtime="$steamapps/common/$installdir"
                break 2
            fi
        done
    done
    if [[ -z "$runtime" ]]; then
        log "WARNING: Steam Linux Runtime (app $runtime_appid) not found; running $underlying_name without its container"
    fi
fi

if [[ -n "$runtime" ]]; then
    export STEAM_COMPAT_TOOL_PATHS="$underlying:$runtime"
    log "exec $runtime/_v2-entry-point --verb=$verb -- $proton $*"
    exec "$runtime/_v2-entry-point" "--verb=$verb" -- "$proton" "$@"
fi
export STEAM_COMPAT_TOOL_PATHS="$underlying"
log "exec $proton $*"
exec "$proton" "$@"
